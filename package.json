    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "supabase": "^2.115.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "packageManager": "pnpm@11.1.3"
}
